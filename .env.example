# 複製成 .env 後填入自己的值；.env 不會被 commit
# API_KEY=

# 國語朗讀（tools/gen_tts.py --engine openai，用 OPENAI_API_KEY）
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=coral
# OPENAI_TTS_INSTRUCT=用台灣口音的國語，語氣溫和、清楚、稍慢，像在跟家裡的長輩說話。

# Qwen3 TTS（備案；tools/gen_tts.py --engine local / api）
# DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# QWEN_TTS_MODEL=qwen3-tts-flash
# QWEN_TTS_VOICE_ZH=Cherry
# QWEN_TTS_VOICE_NAN=Roy

# LLM harness（docs/llm-harness.md）
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6-astra
# OPENAI_REASONING_EFFORT=xhigh
# OPENAI_IMAGE_DETAIL=original
# EXTRACT_ENGINE=vision
